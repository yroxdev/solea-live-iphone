<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:background="#111827" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="● SOLÉA LIVE" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp"/>
    <TextView android:id="@+id/solea_stop" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:textColor="#F6CA43" android:textSize="15sp"/>
    <TextView android:id="@+id/solea_departures" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:textColor="#FFFFFF" android:textSize="13sp"/>
</LinearLayout>
